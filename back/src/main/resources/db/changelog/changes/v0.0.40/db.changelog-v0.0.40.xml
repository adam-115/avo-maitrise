<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- Configuration à chaud de l'intégration Messagerie & Calendrier (OAuth2 Google / Microsoft 365) -->
    <changeSet id="add-oauth-columns-mail-integration-config" author="adam">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="mail_integration_config"/>
            <not><columnExists tableName="mail_integration_config" columnName="google_client_id"/></not>
        </preConditions>
        <addColumn tableName="mail_integration_config">
            <column name="frontend_url" type="VARCHAR(500)"/>
            <column name="microsoft_client_id" type="VARCHAR(255)"/>
            <column name="microsoft_client_secret_enc" type="TEXT"/>
            <column name="microsoft_tenant_id" type="VARCHAR(120)"/>
            <column name="microsoft_redirect_uri" type="VARCHAR(500)"/>
            <column name="google_client_id" type="VARCHAR(255)"/>
            <column name="google_client_secret_enc" type="TEXT"/>
            <column name="google_redirect_uri" type="VARCHAR(500)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
