        <dropTable tableName="invoice_dossier_service_status" cascadeConstraints="true"/>
    </changeSet>

    <changeSet logicalFilePath="changes/v0.0.13/db.changelog-v0.0.13.xml" id="add-currency-tva-to-cabinet" author="antigravity">
