    </changeSet>

    <changeSet logicalFilePath="changes/v0.0.12/change_status_to_enum.xml" id="1" author="antigravity">
        <!-- Add the new enum column to invoice_dossier_services -->
        <addColumn tableName="invoice_dossier_services">
            <column name="status" type="VARCHAR(50)">
            </column>
        </addColumn>

        <update tableName="invoice_dossier_services">
            <column name="status" value="A_FACTURE" />
        </update>

        <addNotNullConstraint tableName="invoice_dossier_services" columnName="status" columnDataType="VARCHAR(50)" />
    </changeSet>

    <changeSet logicalFilePath="changes/v0.0.12/change_status_to_enum.xml" id="2" author="antigravity" dbms="mysql">
        <!-- Execute raw SQL to drop foreign key for MySQL since the constraint name is auto-generated by Hibernate -->
        <sql>
            SET @constraint_name = (
                SELECT CONSTRAINT_NAME
                FROM information_schema.KEY_COLUMN_USAGE
                WHERE TABLE_SCHEMA = DATABASE() 
                  AND TABLE_NAME = 'invoice_dossier_services' 
                  AND COLUMN_NAME = 'invoice_dossier_servie_status_id'
            );
            
            SET @query = IF(@constraint_name IS NOT NULL, CONCAT('ALTER TABLE invoice_dossier_services DROP FOREIGN KEY ', @constraint_name), 'SELECT 1');
            PREPARE stmt FROM @query;
            EXECUTE stmt;
            DEALLOCATE PREPARE stmt;
        </sql>
    </changeSet>

    <changeSet logicalFilePath="changes/v0.0.12/change_status_to_enum.xml" id="3" author="antigravity">
        <!-- Drop the column -->
        <dropColumn tableName="invoice_dossier_services" columnName="invoice_dossier_servie_status_id"/>
    </changeSet>

    <changeSet logicalFilePath="changes/v0.0.12/change_status_to_enum.xml" id="4" author="antigravity">
