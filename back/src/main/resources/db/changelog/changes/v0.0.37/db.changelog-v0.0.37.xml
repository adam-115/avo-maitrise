<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- 1. Table référentielle des règles de délais de procédure -->
    <changeSet id="create-deadline-rules-table" author="adam">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="deadline_rules"/></not>
        </preConditions>
        <createTable tableName="deadline_rules">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(80)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="pays" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="domaine_code" type="VARCHAR(30)" defaultValue="ALL">
                <constraints nullable="false"/>
            </column>
            <column name="categorie" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="libelle" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="duree_valeur" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="duree_unite" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="computation_mode" type="VARCHAR(30)" defaultValue="FR_CPC_640_642">
                <constraints nullable="false"/>
            </column>
            <column name="proroge_weekend_ferie" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="est_franc" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="criticite_defaut" type="VARCHAR(20)" defaultValue="CRITIQUE">
                <constraints nullable="false"/>
            </column>
            <column name="base_legale" type="VARCHAR(255)"/>
            <column name="source_url" type="VARCHAR(500)"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- 2. Table des délais calculés sur chaque dossier (historisée par Envers pour la RCP) -->
    <changeSet id="create-dossier-deadlines-table" author="adam">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="dossier_deadlines"/></not>
        </preConditions>
        <createTable tableName="dossier_deadlines">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="dossier_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="rule_id" type="BIGINT"/>
            <column name="pays" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="titre" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="categorie" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="trigger_event_label" type="VARCHAR(255)"/>
            <column name="date_depart" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="date_echeance_calculee" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="date_echeance_finale" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="detail_calcul" type="TEXT"/>
            <column name="base_legale" type="VARCHAR(255)"/>
            <column name="source_url" type="VARCHAR(500)"/>
            <column name="delai_distance_mois" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="alsace_moselle" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="suspension_jours" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="statut" type="VARCHAR(30)" defaultValue="ACTIF">
                <constraints nullable="false"/>
            </column>
            <column name="criticite" type="VARCHAR(20)" defaultValue="CRITIQUE">
                <constraints nullable="false"/>
            </column>
            <column name="responsable_id" type="VARCHAR(50)"/>
            <column name="suppleant_id" type="VARCHAR(50)"/>
            <column name="valide_par" type="VARCHAR(120)"/>
            <column name="valide_le" type="TIMESTAMP"/>
            <column name="accompli_par" type="VARCHAR(120)"/>
            <column name="accompli_le" type="TIMESTAMP"/>
            <column name="justificatif_accomplissement" type="TEXT"/>
            <column name="motif_modification" type="TEXT"/>
            <column name="matter_event_id" type="BIGINT"/>
            <column name="document_id" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <createIndex tableName="dossier_deadlines" indexName="idx_dossier_deadlines_dossier">
            <column name="dossier_id"/>
        </createIndex>
        <createIndex tableName="dossier_deadlines" indexName="idx_dossier_deadlines_statut_date">
            <column name="statut"/>
            <column name="date_echeance_finale"/>
        </createIndex>
    </changeSet>

    <!-- 2b. Table d'audit Envers pour dossier_deadlines -->
    <changeSet id="create-dossier-deadlines-aud-table" author="adam">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="revinfo"/>
                <not><tableExists tableName="dossier_deadlines_aud"/></not>
            </and>
        </preConditions>
        <createTable tableName="dossier_deadlines_aud">
            <column name="id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="rev" type="INT"><constraints nullable="false"/></column>
            <column name="revtype" type="TINYINT"/>
            <column name="dossier_id" type="BIGINT"/>
            <column name="rule_id" type="BIGINT"/>
            <column name="pays" type="VARCHAR(30)"/>
            <column name="titre" type="VARCHAR(255)"/>
            <column name="categorie" type="VARCHAR(30)"/>
            <column name="trigger_event_label" type="VARCHAR(255)"/>
            <column name="date_depart" type="DATE"/>
            <column name="date_echeance_calculee" type="DATE"/>
            <column name="date_echeance_finale" type="DATE"/>
            <column name="detail_calcul" type="TEXT"/>
            <column name="base_legale" type="VARCHAR(255)"/>
            <column name="source_url" type="VARCHAR(500)"/>
            <column name="delai_distance_mois" type="INT"/>
            <column name="alsace_moselle" type="BOOLEAN"/>
            <column name="suspension_jours" type="INT"/>
            <column name="statut" type="VARCHAR(30)"/>
            <column name="criticite" type="VARCHAR(20)"/>
            <column name="responsable_id" type="VARCHAR(50)"/>
            <column name="suppleant_id" type="VARCHAR(50)"/>
            <column name="valide_par" type="VARCHAR(120)"/>
            <column name="valide_le" type="TIMESTAMP"/>
            <column name="accompli_par" type="VARCHAR(120)"/>
            <column name="accompli_le" type="TIMESTAMP"/>
            <column name="justificatif_accomplissement" type="TEXT"/>
            <column name="motif_modification" type="TEXT"/>
            <column name="matter_event_id" type="BIGINT"/>
            <column name="document_id" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <addPrimaryKey tableName="dossier_deadlines_aud" columnNames="id, rev" constraintName="pk_dossier_deadlines_aud"/>
    </changeSet>

    <!-- 3. Journal d'envoi des alertes (évite les doublons par palier J-30, J-15, J-7, J-3, J-1, J0) -->
    <changeSet id="create-deadline-alert-logs-table" author="adam">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="deadline_alert_logs"/></not>
        </preConditions>
        <createTable tableName="deadline_alert_logs">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="deadline_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="alert_stage" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="sent_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="recipients" type="VARCHAR(500)"/>
            <column name="channel" type="VARCHAR(30)"/>
        </createTable>
        <addUniqueConstraint tableName="deadline_alert_logs"
                             columnNames="deadline_id, alert_stage"
                             constraintName="uq_deadline_alert_stage"/>
    </changeSet>

    <!-- 4. Catégorie d'événement agenda pour les échéances de procédure -->
    <changeSet id="seed-event-type-echeance-procedure" author="adam">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM event_types WHERE code = 'ECHEANCE_PROCEDURE'</sqlCheck>
        </preConditions>
        <insert tableName="event_types">
            <column name="code" value="ECHEANCE_PROCEDURE"/>
            <column name="label" value="Échéance de Procédure (Délai légal)"/>
            <column name="color" value="#DC2626"/>
            <column name="active" valueBoolean="true"/>
            <column name="display_order" valueNumeric="10"/>
        </insert>
    </changeSet>

