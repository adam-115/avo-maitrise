<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="create-cabinet-profile-table" author="antigravity">
        <createTable tableName="cabinet_profile">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="address" type="VARCHAR(255)"/>
            <column name="city" type="VARCHAR(255)"/>
            <column name="postal_code" type="VARCHAR(255)"/>
            <column name="country" type="VARCHAR(255)"/>
            <column name="phone" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="website" type="VARCHAR(255)"/>
            <column name="siret" type="VARCHAR(255)"/>
            <column name="vat_number" type="VARCHAR(255)"/>
            <column name="iban" type="VARCHAR(255)"/>
            <column name="bic" type="VARCHAR(255)"/>
            <column name="logo" type="BLOB"/>
            <column name="logo_content_type" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
