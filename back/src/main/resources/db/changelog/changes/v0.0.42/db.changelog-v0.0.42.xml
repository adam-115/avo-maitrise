<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- Lien optionnel entre une note vocale et son fichier audio archivé en GED (documents.id) -->
    <changeSet id="add-audio-document-id-to-notes" author="adam">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="notes"/>
            <not>
                <columnExists tableName="notes" columnName="audio_document_id"/>
            </not>
        </preConditions>
        <addColumn tableName="notes">
            <column name="audio_document_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
