<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- Audio de la description du dossier (stocké dans MinIO/SeaweedFS via documents) -->
    <changeSet id="add-description-audio-to-dossiers" author="adam">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="dossiers" columnName="description_audio_document_id"/>
            </not>
        </preConditions>
        <addColumn tableName="dossiers">
            <column name="description_audio_document_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet id="add-description-audio-to-dossiers-aud" author="adam">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="dossiers_aud"/>
                <not>
                    <columnExists tableName="dossiers_aud" columnName="description_audio_document_id"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="dossiers_aud">
            <column name="description_audio_document_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
