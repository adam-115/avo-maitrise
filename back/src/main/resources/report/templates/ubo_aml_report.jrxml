<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="ubo_aml_report" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30" whenNoDataType="AllSectionsNoDetail" uuid="b2c3d4e5-f6a7-8b9c-0d1e-2f3a4b5c6d7e">
    
    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>

    <!-- Styles -->
    <style name="Base" isDefault="true" fontName="SansSerif" fontSize="9" forecolor="#334155"/>
    <style name="HeaderTitle" fontName="SansSerif" fontSize="18" isBold="true" forecolor="#0F172A"/>
    <style name="HeaderSubtitle" fontName="SansSerif" fontSize="9.5" isBold="true" forecolor="#0E7490"/>
    <style name="CabinetName" fontName="SansSerif" fontSize="13" isBold="true" forecolor="#0F172A"/>
    <style name="KpiTitle" fontName="SansSerif" fontSize="8" isBold="true" forecolor="#64748B"/>
    <style name="KpiValue" fontName="SansSerif" fontSize="16" isBold="true" forecolor="#0F172A"/>
    <style name="TableColumnHeader" fontName="SansSerif" fontSize="9" isBold="true" forecolor="#FFFFFF" backcolor="#0F172A" vTextAlign="Middle"/>
    <style name="TableCell" fontName="SansSerif" fontSize="8.5" forecolor="#334155" vTextAlign="Middle">
        <box topPadding="4" leftPadding="4" bottomPadding="4" rightPadding="4">
            <bottomPen lineWidth="0.5" lineColor="#E2E8F0"/>
        </box>
    </style>

    <!-- Parameters -->
    <parameter name="cabinetName" class="java.lang.String"/>
    <parameter name="cabinetAddress" class="java.lang.String"/>
    <parameter name="cabinetPhone" class="java.lang.String"/>
    <parameter name="cabinetEmail" class="java.lang.String"/>
    <parameter name="logo" class="java.io.InputStream"/>
    <parameter name="reportDate" class="java.lang.String"/>
    <parameter name="periodText" class="java.lang.String"/>
    <parameter name="totalUbos" class="java.lang.String"/>
    <parameter name="complianceRate" class="java.lang.String"/>
    <parameter name="highRiskCount" class="java.lang.String"/>
    <parameter name="blockedCount" class="java.lang.String"/>
    <parameter name="expertComment" class="java.lang.String"/>
    <parameter name="lastScreeningDate" class="java.lang.String"/>

    <!-- Fields (DataSource) -->
    <field name="uboName" class="java.lang.String"/>
    <field name="clientName" class="java.lang.String"/>
    <field name="roleAndOwnership" class="java.lang.String"/>
    <field name="nationality" class="java.lang.String"/>
    <field name="riskLevel" class="java.lang.String"/>
    <field name="amlStatus" class="java.lang.String"/>

    <!-- Title & Executive Summary Band -->
    <title>
        <band height="255" splitType="Stretch">
            <!-- Logo -->
            <image scaleImage="RetainShape" hAlign="Left" vAlign="Top">
                <reportElement x="0" y="0" width="130" height="50" uuid="11111111-2222-3333-4444-555555555555">
                    <printWhenExpression><![CDATA[$P{logo} != null]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{logo}]]></imageExpression>
            </image>

            <!-- Left: Cabinet Info -->
            <textField textAdjust="StretchHeight">
                <reportElement style="CabinetName" positionType="Float" x="0" y="55" width="220" height="18" uuid="22222222-3333-4444-5555-666666666666"/>
                <textFieldExpression><![CDATA[$P{cabinetName} != null ? $P{cabinetName} : "Cabinet d'Avocats"]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement style="Base" positionType="Float" x="0" y="74" width="220" height="35" forecolor="#64748B" uuid="33333333-4444-5555-6666-777777777777"/>
                <textFieldExpression><![CDATA[($P{cabinetAddress} != null ? $P{cabinetAddress} + "\n" : "") +
"Tél: " + ($P{cabinetPhone} != null ? $P{cabinetPhone} : "") + " | Email: " + ($P{cabinetEmail} != null ? $P{cabinetEmail} : "")]]></textFieldExpression>
            </textField>

            <!-- Top Right: Title and Subtitle -->
            <staticText>
                <reportElement style="HeaderTitle" x="230" y="0" width="305" height="28" uuid="44444444-5555-6666-7777-888888888888"/>
                <textElement textAlignment="Right" verticalAlignment="Top"/>
                <text><![CDATA[AUDIT LCB-FT DES UBOs]]></text>
            </staticText>
            <staticText>
                <reportElement style="HeaderSubtitle" x="230" y="28" width="305" height="18" uuid="55555555-6666-7777-8888-999999999999"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Bénéficiaires Effectifs - Vigilance renforcée (Art. L.561-4-2 CMF)]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement style="Base" x="230" y="50" width="305" height="14" forecolor="#334155" uuid="66666666-7777-8888-9999-000000000001"/>
                <textElement textAlignment="Right">
                    <font isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Date de génération : " + ($P{reportDate} != null ? $P{reportDate} : "")]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement style="Base" x="230" y="66" width="305" height="16" forecolor="#0E7490" uuid="77777777-8888-9999-0000-111111111111"/>
                <textElement textAlignment="Right">
                    <font isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Période d'audit : " + ($P{periodText} != null ? $P{periodText} : "2 dernières années (Défaut)")]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement style="Base" x="150" y="83" width="385" height="24" forecolor="#475569" uuid="77777777-8888-9999-0000-222222222222"/>
                <textElement textAlignment="Right">
                    <font size="8" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Moteur LCB-FT : OpenSanctions via Yente (Sanctions, PPE & Watchlists)\nDernier contrôle : " + ($P{lastScreeningDate} != null ? $P{lastScreeningDate} : "Contrôle en continu")]]></textFieldExpression>
            </textField>

            <!-- KPI BOXES (Y: 112, height: 48) -->
            <!-- Box 1: Total UBOs -->
            <rectangle radius="6">
                <reportElement x="0" y="112" width="125" height="48" backcolor="#F8FAFC" uuid="88888888-1111-0000-2222-333333333333"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="KpiTitle" x="8" y="117" width="110" height="12" uuid="99999999-2222-1111-3333-444444444444"/>
                <text><![CDATA[TOTAL UBOs AUDITÉS]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement style="KpiValue" x="8" y="132" width="110" height="22" uuid="aaaaaaa1-3333-2222-4444-555555555555"/>
                <textFieldExpression><![CDATA[$P{totalUbos} != null ? $P{totalUbos} : "0"]]></textFieldExpression>
            </textField>

            <!-- Box 2: Compliance Rate -->
            <rectangle radius="6">
                <reportElement x="135" y="112" width="125" height="48" backcolor="#F0FDF4" uuid="aaaaaaa2-2222-3333-4444-111111111111"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#86EFAC"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="KpiTitle" x="143" y="117" width="110" height="12" forecolor="#16A34A" uuid="aaaaaaa3-3333-4444-5555-222222222222"/>
                <text><![CDATA[TAUX DE CONFORMITÉ]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement style="KpiValue" x="143" y="132" width="110" height="22" forecolor="#15803D" uuid="aaaaaaa4-4444-5555-6666-333333333333"/>
                <textFieldExpression><![CDATA[$P{complianceRate} != null ? $P{complianceRate} : "0%"]]></textFieldExpression>
            </textField>

            <!-- Box 3: High Risk Count -->
            <rectangle radius="6">
                <reportElement x="270" y="112" width="125" height="48" backcolor="#FFFBEB" uuid="aaaaaaa5-2222-3333-4444-444444444444"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#FCD34D"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="KpiTitle" x="278" y="117" width="110" height="12" forecolor="#D97706" uuid="aaaaaaa6-3333-4444-5555-555555555555"/>
                <text><![CDATA[RISQUE ÉLEVÉ / PPE]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement style="KpiValue" x="278" y="132" width="110" height="22" forecolor="#B45309" uuid="aaaaaaa7-4444-5555-6666-666666666666"/>
                <textFieldExpression><![CDATA[$P{highRiskCount} != null ? $P{highRiskCount} : "0"]]></textFieldExpression>
            </textField>

            <!-- Box 4: Blocked Count -->
            <rectangle radius="6">
                <reportElement x="405" y="112" width="130" height="48" backcolor="#FFF1F2" uuid="aaaaaaa8-2222-3333-4444-777777777777"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#FDA4AF"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="KpiTitle" x="413" y="117" width="115" height="12" forecolor="#E11D48" uuid="aaaaaaa9-3333-4444-5555-888888888888"/>
                <text><![CDATA[UBOs BLOQUÉS]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement style="KpiValue" x="413" y="132" width="115" height="22" forecolor="#BE123C" uuid="aaaaaab0-4444-5555-6666-999999999999"/>
                <textFieldExpression><![CDATA[$P{blockedCount} != null ? $P{blockedCount} : "0"]]></textFieldExpression>
            </textField>

            <!-- Expert Assessment Section (Y: 172 to 237) -->
            <rectangle radius="6">
                <reportElement x="0" y="172" width="535" height="65" backcolor="#F8FAFC" uuid="aaaaaab1-2222-3333-4444-000000000001"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <!-- Cyan left accent bar -->
            <rectangle>
                <reportElement x="0" y="172" width="5" height="65" backcolor="#0E7490" uuid="aaaaaab2-3333-4444-5555-000000000002"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="HeaderSubtitle" x="15" y="178" width="500" height="14" uuid="aaaaaab3-4444-5555-6666-000000000003"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[CONCLUSION D'AUDIT SUR LES BÉNÉFICIAIRES EFFECTIFS (EXPERT AML)]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement style="Base" x="15" y="196" width="510" height="36" forecolor="#334155" uuid="aaaaaab4-5555-6666-7777-000000000004"/>
                <textElement>
                    <font size="8.5"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{expertComment} != null ? $P{expertComment} : "Évaluation globale des bénéficiaires effectifs conforme aux exigences légales d'identification et d'audit LCB-FT."]]></textFieldExpression>
            </textField>

            <!-- Bottom separator line -->
            <line>
                <reportElement positionType="Float" x="0" y="248" width="535" height="1" forecolor="#CBD5E1" uuid="aaaaaab5-6666-7777-8888-000000000005"/>
                <graphicElement>
                    <pen lineWidth="1.5" lineColor="#CBD5E1"/>
                </graphicElement>
            </line>
        </band>
    </title>

    <!-- Column Header (Widths: 140, 130, 95, 55, 65, 50 = 535) -->
    <columnHeader>
        <band height="26" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="26" backcolor="#0F172A" uuid="bbbbbb01-0000-0000-0000-111111111111"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="TableColumnHeader" x="6" y="0" width="134" height="26" uuid="bbbbbb02-0000-0000-0000-222222222222"/>
                <text><![CDATA[Bénéficiaire (UBO)]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableColumnHeader" x="140" y="0" width="130" height="26" uuid="bbbbbb03-0000-0000-0000-333333333333"/>
                <text><![CDATA[Entité Rattachée]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableColumnHeader" x="270" y="0" width="95" height="26" uuid="bbbbbb04-0000-0000-0000-444444444444"/>
                <text><![CDATA[Rôle / Contrôle]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableColumnHeader" x="365" y="0" width="55" height="26" uuid="bbbbbb05-0000-0000-0000-555555555555"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Nationalité]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableColumnHeader" x="420" y="0" width="65" height="26" uuid="bbbbbb06-0000-0000-0000-666666666666"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Risque]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableColumnHeader" x="485" y="0" width="50" height="26" uuid="bbbbbb07-0000-0000-0000-777777777777"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Statut]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detail Band (Table Rows) -->
    <detail>
        <band height="24" splitType="Stretch">
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="TableCell" x="6" y="0" width="134" height="24" forecolor="#0F172A" uuid="cccccc01-1111-2222-3333-444444444444"/>
                <textElement><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{uboName}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="TableCell" x="140" y="0" width="130" height="24" forecolor="#334155" uuid="cccccc02-1111-2222-3333-444444444444"/>
                <textFieldExpression><![CDATA[$F{clientName}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="TableCell" x="270" y="0" width="95" height="24" forecolor="#475569" uuid="cccccc03-1111-2222-3333-444444444444"/>
                <textFieldExpression><![CDATA[$F{roleAndOwnership}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="TableCell" x="365" y="0" width="55" height="24" forecolor="#64748B" uuid="cccccc04-1111-2222-3333-444444444444"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{nationality}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="TableCell" x="420" y="0" width="65" height="24" uuid="cccccc05-1111-2222-3333-444444444444"/>
                <textElement textAlignment="Center"><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{riskLevel}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="TableCell" x="485" y="0" width="50" height="24" forecolor="#0E7490" uuid="cccccc06-1111-2222-3333-444444444444"/>
                <textElement textAlignment="Right"><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{amlStatus}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Page Footer -->
    <pageFooter>
        <band height="32" splitType="Stretch">
            <line>
                <reportElement x="0" y="2" width="535" height="1" forecolor="#E2E8F0" uuid="dddddd01-0000-0000-0000-000000000001"/>
            </line>
            <staticText>
                <reportElement style="Base" x="0" y="8" width="350" height="16" forecolor="#94A3B8" uuid="dddddd02-0000-0000-0000-000000000002"/>
                <textElement><font size="8"/></textElement>
                <text><![CDATA[Avo Maîtrise - Audit LCB-FT confidentiel à usage exclusif du cabinet]]></text>
            </staticText>
            <textField>
                <reportElement style="Base" x="380" y="8" width="155" height="16" forecolor="#64748B" uuid="dddddd03-0000-0000-0000-000000000003"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
