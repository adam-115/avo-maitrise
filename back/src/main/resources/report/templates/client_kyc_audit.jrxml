                <textFieldExpression><![CDATA["Moteur LCB-FT : Contrôle automatisé continu (Sanctions Internationales, Registres de Gel & PPE)\nDernier criblage d'alertes : " + ($P{lastScreeningDate} != null ? $P{lastScreeningDate} : "Contrôle en continu")]]></textFieldExpression>
