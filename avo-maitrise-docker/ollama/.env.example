# Copier en .env puis adapter.

# Image Ollama (figer une version précise en production)
OLLAMA_IMAGE=ollama/ollama:latest

# IP sur laquelle publier le port. 127.0.0.1 = local uniquement.
# Mettre l'IP du tunnel WireGuard/Tailscale (ex. 10.8.0.1). Éviter 0.0.0.0 : Ollama n'a pas d'authentification.
OLLAMA_BIND_IP=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MEMORY_LIMIT=22g

# Modèles
CHAT_MODEL_NAME=avo-qwen
EMBEDDING_MODEL=nomic-embed-text

# Réglages Ollama (lus par le conteneur via env_file)
OLLAMA_KEEP_ALIVE=-1
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
