# ==============================================================================
# CONFIGURATION SAUVEGARDE OVHCLOUD OBJECT STORAGE (S3) — PAR CABINET
# Copier ce fichier en : ovh-backup.env  (puis: chmod 600 ovh-backup.env)
# ==============================================================================

# 1. Identifiant unique du cabinet (crée automatiquement un dossier dédié sur S3)
# Exemples : cabinet-igri, cabinet-dupont, cabinet-martin
CABINET_ID=cabinet-igri

# 2. Paramètres OVHcloud Object Storage (S3)
# Régions courantes : gra (Gravelines), sbg (Strasbourg), rbx (Roubaix), bhs (Beauharnois)
# Choisir une région DIFFÉRENTE de celle du VPS pour une vraie tolérance aux sinistres !
OVH_S3_REGION=gra
OVH_S3_BUCKET=avo-maitrise-backups
AWS_ACCESS_KEY_ID=REMPLACER_PAR_VOTRE_ACCESS_KEY_OVH
AWS_SECRET_ACCESS_KEY=REMPLACER_PAR_VOTRE_SECRET_KEY_OVH

# 3. Mot de passe de chiffrement AES-256 côté client (Restic)
# CRITIQUE : Conserver une copie de ce mot de passe HORS du serveur (gestionnaire de mots de passe) !
# Sans ce mot de passe, il est IMPOSSIBLE de déchiffrer les sauvegardes.
RESTIC_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_FORT_32_CHARS

# 4. Chemins locaux sur le VPS à sauvegarder
STACK_ROOT=/home/adam/avo-maitrise-docker
KEYCLOAK_BACKUP_DIR=/home/adam/backup

# 5. Politique de rétention sur OVH S3
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6
